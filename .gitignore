# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
# Local Gradle/Metro run logs, one per debugging session -- two dozen of them
# had accumulated untracked alongside the source.
gradle-build-*.log
metro-*.log

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
modules/*/android/build/
modules/*/android/.cxx/

# Zur Bauzeit geladenes MediaPipe-Handmodell (7,8 MB) -- siehe den
# Gradle-Task downloadHandLandmarker. Gehoert nicht ins Repository.
modules/*/android/src/main/assets/*.task
