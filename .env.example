# Copy to .env.local (production defaults, gitignored) or .env.staging.local
# and point EXPO_PUBLIC_API_BASE / WEBAPP / RPC_URL at a non-production chain
# node to build a staging flavor. Any var left unset here falls back to the
# production aequitas.digital values hardcoded in lib/config.ts.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
EXPO_PUBLIC_API_BASE=
EXPO_PUBLIC_WEBAPP=
EXPO_PUBLIC_RPC_URL=

# Phase 0 biometric proof-of-personhood (palm+face) -- OFF by default. Only
# turn on once Phase 0 accuracy validation + Phase 2 legal review are
# actually done; see aequitas-biometric-beta/README.md. Keep
# EXPO_PUBLIC_BIOMETRIC_ENABLED false until COORDINATOR_BASE is live.
EXPO_PUBLIC_BIOMETRIC_ENABLED=
EXPO_PUBLIC_COORDINATOR_BASE=

# Phase 0 launch: allow device-secret registration without face/coordinator.
# Explicit opt-in only (=== 'true'). When unset/false and BIOMETRIC is off,
# Identity fail-closes — not a silent fallback.
EXPO_PUBLIC_ALLOW_DEVICE_SECRET_REGISTER=

# Android Play Integrity attestation (see lib/attestation.ts) -- the
# numeric Project number (not Project ID) from the Cloud project linked
# under Play Console > digital.aequitas.app > Setup > App integrity.
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
